DATABASE_URL="postgresql://unique_accessories:<password>@localhost:5432/unique_accessories_launch_dev?schema=public"
PORT=4000
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Local development media (optional)
UPLOAD_DIR=uploads/products
# Fill these five values together. Blank values keep local development uploads working.
# R2_PUBLIC_URL is a public custom domain or development r2.dev URL, not the S3 endpoint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Optional: override for EU/other jurisdiction buckets; normally leave blank.
R2_ENDPOINT=

# Customer Google OAuth (Web application client)
SITE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_WEBHOOK_TOKEN=
